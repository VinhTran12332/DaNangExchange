{
    "meta": {
        "schema_version": "1.1.0",
        "awf_version": "3.3.0"
    },
    "project": {
        "name": "SanGiaoDich Du Lieu (Data Marketplace)",
        "type": "Data Marketplace / Fintech",
        "status": "Pivot to Enterprise MVP"
    },
    "tech_stack": {
        "frontend": {
            "framework": "React (Vite)",
            "styling": "Tailwind CSS",
            "icons": "Lucide React"
        },
        "backend": {
            "runtime": "Node.js",
            "framework": "Express",
            "database": "SQLite (ugdes.db)",
            "blockchain_mock": "Hyperledger Fabric Adapter (Custom SQLite implementation)"
        },
        "authentication": "JWT"
    },
    "database_schema": {
        "summary": "Stores users, data assets, orders, and a tamper-proof ledger of transactions.",
        "tables": [
            {
                "name": "ledger_transactions",
                "columns": [
                    "id",
                    "order_id",
                    "buyer_id",
                    "action_type",
                    "payload",
                    "block_number",
                    "timestamp"
                ],
                "description": "Immutable log of data transactions, simulating a blockchain ledger."
            },
            {
                "name": "users",
                "description": "Standard user management with role-based access."
            },
            {
                "name": "orders",
                "description": "Tracks data purchase requests and status."
            },
            {
                "name": "assets",
                "description": "Catalog of data products available for sale."
            }
        ]
    },
    "api_endpoints": [
        {
            "path": "/api/hyperledger/history/:orderId",
            "method": "GET",
            "explained": "Retrieves the audit trail (transaction history) for a specific order from the immutable ledger."
        },
        {
            "path": "/api/hyperledger/blocks/latest",
            "method": "GET",
            "explained": "Fetches the latest block simulations for the explorer view."
        },
        {
            "path": "/api/auth/*",
            "description": "User authentication endpoints."
        },
        {
            "path": "/api/assets/*",
            "description": "Data catalog management."
        },
        {
            "path": "/api/orders/*",
            "description": "Order processing and management."
        },
        {
            "path": "/api/payment/*",
            "description": "Payment simulation and verification."
        }
    ],
    "features": [
        {
            "name": "Hyperledger Mock Adapter",
            "status": "In Progress",
            "description": "Simulates Fabric consensus and storage using SQLite to enable Enterprise logic without heavy infrastructure."
        },
        {
            "name": "Data Watermarking",
            "status": "Planned",
            "description": "Inject buyer identity into purchased data to prevent leakage."
        },
        {
            "name": "Payment Simulation",
            "status": "Planned",
            "description": "Simulates bank transfers to manage user quotas."
        }
    ],
    "knowledge_items": {
        "patterns": [
            "Service Layer Architecture",
            "Mock Adapter Pattern for Blockchain"
        ],
        "conventions": [
            "Security First (ACID, Sanitization)",
            "No Ethereum/Ethers.js dependencies"
        ]
    }
}